# ── WhatsApp Cloud API (Meta for Developers) ──────────────────────────────
# Phone Number ID: WhatsApp → API Setup → Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=

# Access Token permanente (sin expiración): Meta Business Suite → System Users → Generate Token
WHATSAPP_ACCESS_TOKEN=

# Token de verificación del webhook: cualquier cadena, la misma que pondrás en Meta
WHATSAPP_VERIFY_TOKEN=

# App Secret: Meta for Developers → App → Settings → Basic → App Secret
# Obligatorio (a diferencia de Peluquería): activa la verificación HMAC de cada
# petición entrante y el arranque debe fallar si falta. Ver design.md, 6.4.
WHATSAPP_APP_SECRET=

# WHATSAPP_API_VERSION=v23.0
# opcional, por defecto v23.0

# ── Admin ──────────────────────────────────────────────────────────────────
# Número del administrador en formato internacional sin + ni espacios
# Ej: 34612345678 — habilita comandos admin por WhatsApp (/status, /help, /logs, /restart)
ADMIN_PHONE=

# ── Proxy público (nginx + DuckDNS) ──────────────────────────────────────
# Subdominio registrado en duckdns.org (sin https://)
PUBLIC_DOMAIN=

# Auth Token de DuckDNS: duckdns.org → token de tu cuenta
DUCKDNS_TOKEN=

# ── Logs ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=

# No hacen falta GOOGLE_CALENDAR_ID ni GOOGLE_CREDENTIALS_PATH: este bot no usa
# Google Calendar. Ver design.md, sección 6.5.

# ── Telegram (herramienta interna, no se despliega) ──────────────────────
# Opcional: solo para `make telegram` (tools/telegram_pruebas.py). Token de
# @BotFather. Producción no la necesita.
TELEGRAM_BOT_TOKEN=
