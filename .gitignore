# ── Credentials & secrets ─────────────────────────────────────────────────────
.env
# A diferencia de Peluquería, aquí no se ignora *.json entero: ese patrón
# existía solo por las credenciales de Google, que este proyecto no usa.

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs.txt
logs/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ── Datos generados ────────────────────────────────────────────────────────────
# horarios/ SÍ se versiona (es la fuente de verdad, design.md sección 2.3).
# revision/ se regenera con `make revision` desde cualquier versión: no se versiona.
revision/
*.xlsx